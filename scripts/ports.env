# EdgeFabric — Standard Service Ports (single source of truth)
#
# Source this file from shell scripts:
#   source "$(dirname "$0")/ports.env"
#
# Any new service MUST register its port here, not inline.

# ── Infrastructure ──────────────────────────────────────────────
export EF_PORT_POSTGRES=5432
export EF_PORT_REDIS=6379
export EF_PORT_NATS=4222
export EF_PORT_NATS_MON=8222
export EF_PORT_COTURN=3478
export EF_PORT_COTURN_RELAY_MIN=49152
export EF_PORT_COTURN_RELAY_MAX=49200

# ── EdgeFabric services (native + docker share the same ports) ──
export EF_PORT_API_HTTP=6060          # ef-api REST + WebSocket
export EF_PORT_API_GRPC=50051         # ef-api gRPC (agent control plane)
export EF_PORT_API_SIGNALING=8443     # ef-api WebRTC signaling (streaming)
export EF_PORT_AGENT_STREAM=7070      # ef-agent HTTP/WS streaming server
export EF_PORT_DASHBOARD=9080         # ef-dashboard (Trunk dev server)

# ── Convenience URLs ────────────────────────────────────────────
export EF_URL_API="http://127.0.0.1:${EF_PORT_API_HTTP}"
export EF_URL_DASHBOARD="http://127.0.0.1:${EF_PORT_DASHBOARD}"
export EF_URL_AGENT="http://127.0.0.1:${EF_PORT_AGENT_STREAM}"

# ── Dev credentials (NOT for production) ────────────────────────
export EF_DEV_API_KEY="${EF_DEV_API_KEY:-efdev-key-00000000}"
export EF_DEV_DB_URL="${EF_DEV_DB_URL:-postgres://edgefabric:edgefabric@localhost:5432/edgefabric}"
