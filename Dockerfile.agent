# ── Stage 1: Build ────────────────────────────────────────────────
FROM rust:1.88-bookworm AS builder

RUN apt-get update && apt-get install -y protobuf-compiler && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates/ef-core/Cargo.toml     crates/ef-core/Cargo.toml
COPY crates/ef-db/Cargo.toml       crates/ef-db/Cargo.toml
COPY crates/ef-api/Cargo.toml      crates/ef-api/Cargo.toml
COPY crates/ef-scheduler/Cargo.toml crates/ef-scheduler/Cargo.toml
COPY crates/ef-orchestrator/Cargo.toml crates/ef-orchestrator/Cargo.toml
COPY crates/ef-control/Cargo.toml  crates/ef-control/Cargo.toml
COPY crates/ef-streaming/Cargo.toml crates/ef-streaming/Cargo.toml
COPY crates/ef-agent/Cargo.toml    crates/ef-agent/Cargo.toml
COPY crates/ef-cli/Cargo.toml      crates/ef-cli/Cargo.toml

RUN for crate in ef-core ef-db ef-scheduler ef-orchestrator ef-control ef-streaming; do \
      mkdir -p crates/$crate/src && echo "// dummy" > crates/$crate/src/lib.rs; \
    done && \
    for bin in ef-api ef-agent ef-cli; do \
      mkdir -p crates/$bin/src && echo "fn main() {}" > crates/$bin/src/main.rs; \
    done

RUN cargo build --release --bin ef-agent 2>/dev/null || true

COPY crates/ crates/
COPY proto/  proto/
COPY config/ config/

RUN cargo build --release --bin ef-agent

# ── Stage 2: Runtime ──────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      android-tools-adb \
      usbutils \
      openssh-client \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash edgefabric

WORKDIR /app

COPY --from=builder /app/target/release/ef-agent /app/ef-agent
COPY --from=builder /app/config/ /app/config/

RUN chown -R edgefabric:edgefabric /app
USER edgefabric

ENV RUST_LOG=info

ENTRYPOINT ["/app/ef-agent"]
